PORT=5000
NODE_ENV=development
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_client_id
CLIENT_ORIGIN=http://localhost:5173
AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_DOMAIN=example.com
BREVO_API_KEY=your_brevo_api_key

# Rate Limiting & Abuse Protection (Optional)
RATE_LIMIT_ENABLED=true
LOGIN_ACCOUNT_MAX_FAILS=5
LOGIN_ACCOUNT_WINDOW_MS=900000
LOGIN_IP_MAX=30
LOGIN_IP_WINDOW_MS=900000
OTP_SEND_EMAIL_MAX=5
OTP_SEND_EMAIL_WINDOW_MS=3600000
OTP_SEND_IP_MAX=20
OTP_SEND_IP_WINDOW_MS=900000
OTP_VERIFY_MAX=15
OTP_VERIFY_WINDOW_MS=900000
PASSWORD_RESET_MAX=10
PASSWORD_RESET_WINDOW_MS=900000

