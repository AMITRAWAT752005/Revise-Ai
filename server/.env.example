PORT=5000
NODE_ENV=development
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_client_id
CLIENT_ORIGIN=http://localhost:5173
AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_DOMAIN=example.com
BREVO_API_KEY=your_brevo_api_key

# Gemini syllabus extraction (server-side only)
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=300000

# Rate Limiting & Abuse Protection (Optional)
RATE_LIMIT_ENABLED=true
LOGIN_ACCOUNT_MAX_FAILS=5
LOGIN_ACCOUNT_WINDOW_MS=900000
LOGIN_IP_MAX=30
LOGIN_IP_WINDOW_MS=900000
OTP_SEND_EMAIL_MAX=5
OTP_SEND_EMAIL_WINDOW_MS=3600000
OTP_SEND_IP_MAX=20
OTP_SEND_IP_WINDOW_MS=900000
OTP_VERIFY_MAX=15
OTP_VERIFY_WINDOW_MS=900000
PASSWORD_RESET_MAX=10
PASSWORD_RESET_WINDOW_MS=900000

# Cloudinary Integration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
